      "credentials": {
        "googlePalmApi": {
          "id": null,
          "name": "",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Company: {{ $('Receive Lead').item.json.company }}. Website title: {{ $json.title }}. Description: {{ $json.description }}. Lead message: {{ $('Receive Lead').item.json.message }}. In two sentences, summarize what this company likely does and name its industry in one or two words. If information is missing, say Unknown. Format exactly: Industry: X. Summary: Y.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -480,
        32
      ],
      "id": "f07fdf11-ac24-465b-bcec-c7c68b9597c3",
      "name": "Summarize Company",
      "retryOnFail": true,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "01266b5d-4c13-4c90-b5b5-c5a0f5611bb5",
              "name": "industry",
              "value": "={{ ($json.text.split('Summary:')[0].replace('Industry:','').replace(/\\.\\s*$/,'')).trim() || 'Unknown' }}",
              "type": "string"
            },
            {
              "id": "3a478812-4cfe-44ef-9c05-3355122c0907",
              "name": "company_summary",
              "value": "={{ $json.text.includes('Summary:') ? $json.text.split('Summary:')[1].trim() : $json.text }}",
              "type": "string"
            },
            {
              "id": "6bdc9536-c748-490c-8b29-f2b1ca4ec64e",
              "name": "domain",
              "value": "={{ $('Receive Lead').item.json.domain }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
