    {
      "parameters": {
        "jsCode": "const out = $json.output || {};\nconst lead = $('Receive Lead').item.json;\n\nlet score = Number(out.score);\nif (isNaN(score)) score = 0;\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nlet tier = 'Cold';\nif (score >= 65) tier = 'Hot';\nelse if (score >= 40) tier = 'Warm';\n\nconst reasons = Array.isArray(out.reasons)\n  ? out.reasons.join('; ')\n  : String(out.reasons || '');\n\nreturn {\n  json: {\n    ...lead,\n    score,\n    tier,\n    reasons,\n    suggested_action: out.suggested_action || ''\n  }\n};"
      },
